  "features": {
    "product-snippet": {
      "label": "Product result",
      "for": "product results",
      "where": "A product result can show the price, stock or rating under the link.",
      "status": "shown",
      "doc": "https://developers.google.com/search/docs/appearance/structured-data/product-snippet",
      "on": [
        "Product"
      ],
      "required": [
        "name",
        [
          "offers.price|offers.priceSpecification.price",
          "review",
          "aggregateRating"
        ]
      ],
      "recommended": [
        "offers.priceCurrency",
        "offers.availability",
        "brand.name"
      ],
      "not_for": [
        {
          "id": "several_offers",
          "several": "offers",
          "reason": "several plans on one product",
          "why": "A product result is for one product at one price. Several plans are a service with plans, or a group of products."
        }
      ],
      "confirm": [
        "The page is about this one product, not a list or a comparison."
      ],
      "names": [
        "name",
        "offers",
        "price",
        "priceSpecification",
        "priceCurrency",
        "availability",
        "review",
        "aggregateRating",
        "brand"
      ]
    },
    "merchant-listing": {
      "label": "Merchant listing",
      "for": "merchant listings",
      "where": "Your product in shopping results, with its price and stock.",
      "status": "shown",
      "doc": "https://developers.google.com/search/docs/appearance/structured-data/merchant-listing",
      "on": [
        "Product"
      ],
      "required": [
        "name",
        "image",
        "offers.price|offers.priceSpecification.price",
        "offers.priceCurrency|offers.priceSpecification.priceCurrency"
      ],
      "recommended": [
        "description",
        "brand.name",
        "sku",
        "offers.availability"
      ],
      "rules": [
        {
          "path": "offers.price",
          "gt": 0,
          "need": "a price above zero"
        },
        {
          "path": "offers.@type",
          "is": "Offer"
        }
      ],
      "not_for": [
        {
          "id": "recurring",
          "exists": "offers.priceSpecification.billingDuration",
          "reason": "a recurring price",
          "why": "Shopping listings are for things people buy and own. Memberships and subscriptions are services: describe them as plans for a service.",
          "suggest": "Service"
        },
        {
          "id": "several_offers",
          "several": "offers",
          "reason": "several plans on one product",
          "why": "Shopping listings are for one product at one price. Several plans are a service with plans.",
          "suggest": "Service"
        },
        {
          "id": "not_sold_here",
          "seller": "offers.seller",
          "reason": "not bought on this page",
          "why": "Shopping listings are for pages where people buy the product from you. A review or a comparison can still show a product result."
        }
      ],
      "confirm": [
        "The price on the page is the price people pay."
      ],
      "names": [
        "name",
        "image",
        "offers",
        "price",
        "priceSpecification",
        "priceCurrency",
        "billingDuration",
        "seller",
        "availability",
        "description",
        "brand",
        "sku"
      ]
    },
