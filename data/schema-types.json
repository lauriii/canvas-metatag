{
  "$shapes": {
    "address": {
      "type": "PostalAddress",
      "requires": [["streetAddress", "addressLocality"], ["addressCountry"]],
      "parts": [
        { "key": "streetAddress", "label": "Street address", "kind": "text", "compose": true },
        { "key": "postalCode", "label": "Postal code", "kind": "text" },
        { "key": "addressLocality", "label": "City", "kind": "text" },
        { "key": "addressRegion", "label": "Region", "kind": "text" },
        { "key": "addressCountry", "label": "Country", "kind": "enum", "codes": "country", "emit": "code", "suggest": "country", "ai": false }
      ]
    },
    "venue": {
      "type": "Place",
      "requires": [["name", "address"]],
      "parts": [
        { "key": "name", "label": "Name", "kind": "text", "compose": true },
        { "key": "address", "label": "Address", "use": "address" }
      ]
    },
    "who": {
      "type": "Thing",
      "requires": [["name"]],
      "parts": [
        { "key": "name", "label": "Name", "kind": "text", "compose": true, "ai": false },
        { "key": "url", "label": "Website", "kind": "url" }
      ]
    },
    "geo": {
      "type": "GeoCoordinates",
      "requires": [["latitude"], ["longitude"]],
      "parts": [
        { "key": "latitude", "label": "Latitude", "kind": "number", "range": [-90, 90], "ai": false },
        { "key": "longitude", "label": "Longitude", "kind": "number", "range": [-180, 180], "ai": false }
      ]
    },
    "pay": {
      "type": "MonetaryAmount",
      "nested": { "value": "QuantitativeValue" },
      "requires": [["value_minValue"], ["value_unitText"]],
      "parts": [
        { "key": "value_minValue", "label": "From", "kind": "number", "ai": false },
        { "key": "value_maxValue", "label": "Up to", "kind": "number", "ai": false },
        { "key": "currency", "label": "Currency", "kind": "currency", "ai": false },
        { "key": "value_unitText", "label": "Paid per", "kind": "enum", "options": ["HOUR", "DAY", "WEEK", "MONTH", "YEAR"], "option_labels": { "HOUR": "hour", "DAY": "day", "WEEK": "week", "MONTH": "month", "YEAR": "year" }, "emit": "code", "ai": false }
      ]
    },
    "tickets": {
      "type": "Offer",
      "requires": [["price"]],
      "parts": [
        { "key": "price", "label": "Price", "kind": "number", "ai": false },
        { "key": "priceCurrency", "label": "Currency", "kind": "currency", "ai": false },
        { "key": "availability", "label": "Availability", "kind": "enum", "options": ["InStock", "PreOrder", "NotYet", "SoldOut"], "option_labels": { "InStock": "on sale", "PreOrder": "presale", "NotYet": "not on sale yet", "SoldOut": "sold out" }, "ai": false },
        { "key": "validFrom", "label": "On sale from", "kind": "date", "when": { "availability": ["PreOrder", "NotYet"] } },
        { "key": "url", "label": "Where to buy", "kind": "url" }
      ]
    },
    "nutrition": {
      "type": "NutritionInformation",
      "requires": [["calories"]],
      "needs": ["recipeYield"],
      "parts": [
        { "key": "calories", "label": "Calories", "kind": "number", "format": "{n} calories", "ai": false }
      ]
    }
  },
  "WebPage": {
    "label": "Web page", "page_type": "WebPage",
    "kind": { "label": "A web page", "name": "a web page", "earn": "No search feature of its own. Right for most pages.", "icon": "file", "order": 10 },
    "main": [],
    "variants": "Kind of page",
    "slots": { "name": { "path": "name", "fact": "title" }, "site": { "path": "isPartOf.name", "site": "identity.name", "label": "Site name" } },
    "say": [["{name}, a web page of {site}."]]
  },
  "AboutPage": {
    "label": "About page", "page_type": "AboutPage", "variant_of": "WebPage",
    "slots": { "name": { "path": "name", "fact": "title" }, "site": { "path": "isPartOf.name", "site": "identity.name", "label": "Site name" } },
    "say": [["{name}, the page about {site}."]]
  },
  "ContactPage": {
    "label": "Contact page", "page_type": "ContactPage", "variant_of": "WebPage",
    "slots": { "name": { "path": "name", "fact": "title" }, "site": { "path": "isPartOf.name", "site": "identity.name", "label": "Site name" } },
    "say": [["{name}, the contact page of {site}."]]
  },
  "CollectionPage": {
    "label": "Collection page", "page_type": "CollectionPage", "variant_of": "WebPage",
    "props": [
      { "key": "items", "label": "Pages it lists", "kind": "ref", "list": true, "max": 100, "accept": [], "item": "ListItem", "link_only": true, "scopes": { "page": "component" }, "ai": false }
    ],
    "slots": { "name": { "path": "name", "fact": "title" }, "site": { "path": "isPartOf.name", "site": "identity.name", "label": "Site name" } },
    "say": [["{name}, a page that lists other pages of {site}."]]
  },
  "Article": {
    "label": "Article",
    "primary_type": "Article", "og_type": "article",
    "kind": { "label": "An article", "name": "an article", "earn": "Can show its title, image and date in results.", "icon": "reader", "order": 3 },
    "main": ["image", "datePublished"],
    "variants": "Kind of article",
    "refs": { "publisher": "identity" },
    "props": [
      { "key": "headline", "label": "Headline", "kind": "text", "compose": true, "default": { "fact": "title" } },
      { "key": "description", "label": "Summary", "kind": "text", "compose": true, "default": { "fact": "description" } },
      { "key": "image", "label": "Image", "kind": "image", "list": true, "max": 10, "default": { "fact": "image" } },
      { "key": "datePublished", "label": "Published", "kind": "date", "default": { "fact": "published" } },
      { "key": "dateModified", "label": "Updated", "kind": "date", "default": { "fact": "modified" } },
      { "group": "author", "use": "who", "label": "Author", "type": "Person", "list": true, "ref": { "label": "Author", "accept": ["Person", "Organization"], "site": true }, "defaults": { "name": { "fact": "author" } } }
    ],
    "slots": {
      "headline": { "path": "headline", "prop": "headline" },
      "author": { "path": "author.name", "prop": "author_name" },
      "published": { "path": "datePublished", "prop": "datePublished" }
    },
    "say": [[
      "{headline}, an article by {author}, published {published}.",
      "{headline}, an article by {author}.",
      "{headline}, an article published {published}.",
      "{headline}, an article."
    ]]
  },
  "BlogPosting": {
    "extends": "Article", "variant_of": "Article", "label": "Blog post", "primary_type": "BlogPosting",
    "say": [[
      "{headline}, a blog post by {author}, published {published}.",
      "{headline}, a blog post by {author}.",
      "{headline}, a blog post published {published}.",
      "{headline}, a blog post."
    ]]
  },
  "NewsArticle": {
    "extends": "Article", "variant_of": "Article", "label": "News article", "primary_type": "NewsArticle",
    "say": [[
      "{headline}, a news article by {author}, published {published}.",
      "{headline}, a news article by {author}.",
      "{headline}, a news article published {published}.",
      "{headline}, a news article."
    ]]
  },
  "Event": {
    "label": "Event",
    "primary_type": "Event",
    "kind": { "label": "An event people attend in person", "name": "an event", "earn": "Can show in event listings with its date and place.", "not_for": "Not for events that happen only online.", "icon": "calendar", "order": 4 },
    "main": ["startDate", "location"],
    "props": [
      { "key": "name", "label": "Event name", "kind": "text", "compose": true, "default": { "fact": "title" }, "level": "required" },
      { "key": "startDate", "label": "Starts", "kind": "date", "level": "required" },
      { "key": "endDate", "label": "Ends", "kind": "date" },
      { "group": "location", "use": "venue", "label": "Venue", "level": "required", "ref": { "label": "Venue page", "accept": ["Place"], "inline": "address", "per_item": true } },
      { "key": "description", "label": "Summary", "kind": "text", "compose": true, "default": { "fact": "description" } },
      { "key": "image", "label": "Image", "kind": "image", "default": { "fact": "image" } },
      { "key": "eventStatus", "label": "Status", "kind": "enum", "options": ["EventScheduled", "EventCancelled", "EventPostponed", "EventRescheduled"], "option_labels": { "EventScheduled": "scheduled", "EventCancelled": "cancelled", "EventPostponed": "postponed", "EventRescheduled": "rescheduled" }, "ai": false },
      { "group": "offers", "use": "tickets", "label": "Tickets" },
      { "group": "organizer", "use": "who", "label": "Organizer", "type": "Organization", "ref": { "label": "Organizer", "accept": ["Person", "Organization"], "site": true, "page_default": true } },
      { "key": "performer", "label": "Performers", "kind": "ref", "list": true, "max": 50, "accept": ["Person", "Organization"], "as": "Person", "per_item": true, "scopes": { "page": "component" }, "ai": false }
    ],
    "slots": {
      "name": { "path": "name", "prop": "name" },
      "venue": { "path": "location.name", "prop": "location_name" },
      "city": { "path": "location.address.addressLocality", "prop": "location_address_addressLocality" },
      "start": { "path": "startDate", "prop": "startDate" }
    },
    "say": [[
      "{name}, an event at {venue}, {city}, starting {start}.",
      "{name}, an event in {city}, starting {start}.",
      "{name}, an event at {venue}, starting {start}.",
      "{name}, an event starting {start}."
    ]]
  },
  "Product": {
    "label": "Product",
    "primary_type": "Product",
    "kind": { "label": "A product people buy", "name": "a product", "earn": "Can show a product result and a merchant listing.", "not_for": "Not for services, memberships or subscriptions.", "icon": "cube", "order": 1 },
    "main": ["offers_price", "offers_priceCurrency", "sold_here", "image"],
    "refs": { "offers_seller": { "to": "identity", "if": { "sold_here": "yes" } } },
    "nested": { "offers": "Offer", "brand": "Brand" },
    "props": [
      { "key": "name", "label": "Name", "kind": "text", "compose": true, "default": { "fact": "title" }, "level": "required" },
      { "key": "description", "label": "Summary", "kind": "text", "compose": true, "default": { "fact": "description" } },
      { "key": "image", "label": "Image", "kind": "image", "list": true, "max": 10, "default": { "fact": "image" } },
      { "key": "offers_price", "label": "Price", "kind": "number", "level": "required", "ai": false },
      { "key": "offers_priceCurrency", "label": "Currency", "kind": "currency", "ai": false },
      { "key": "billing", "label": "Billed", "kind": "enum", "options": ["once", "P1M", "P1Y"], "option_labels": { "once": "once", "P1M": "every month", "P1Y": "every year" }, "emit": false, "ai": false },
      { "key": "sold_here", "label": "Bought on this page", "kind": "enum", "options": ["yes", "no"], "option_labels": { "yes": "yes, from us", "no": "no" }, "emit": false, "ai": false },
      { "key": "offers_availability", "label": "Availability", "kind": "enum", "options": ["InStock", "OutOfStock", "PreOrder", "BackOrder", "SoldOut", "Discontinued"], "option_labels": { "InStock": "in stock", "OutOfStock": "out of stock", "PreOrder": "available to pre-order", "BackOrder": "on back order", "SoldOut": "sold out", "Discontinued": "discontinued" }, "ai": false },
      { "key": "brand_name", "label": "Brand", "kind": "text", "compose": true },
      { "key": "sku", "label": "SKU", "kind": "text", "pattern": "^\\S+$", "ai": false }
    ],
    "slots": {
      "name": { "path": "name", "prop": "name" },
      "seller": { "path": "offers.seller.name", "prop": "sold_here", "site": "identity.name", "label": "Seller" },
      "price": { "path": "offers.price", "prop": "offers_price", "currency": "offers.priceCurrency", "unless": "offers.priceSpecification.billingDuration" },
      "price_month": { "path": "offers.price", "prop": "offers_price", "currency": "offers.priceCurrency", "if": { "offers.priceSpecification.billingDuration": "P1M" } },
      "price_year": { "path": "offers.price", "prop": "offers_price", "currency": "offers.priceCurrency", "if": { "offers.priceSpecification.billingDuration": "P1Y" } },
      "availability": { "path": "offers.availability", "prop": "offers_availability" }
    },
    "say": [[
      "{name}, a product sold by {seller} for {price}, {availability}.",
      "{name}, a product sold by {seller} for {price}.",
      "{name}, a product sold by {seller} for {price_month} a month, {availability}.",
      "{name}, a product sold by {seller} for {price_month} a month.",
      "{name}, a product sold by {seller} for {price_year} a year, {availability}.",
      "{name}, a product sold by {seller} for {price_year} a year.",
      "{name}, a product sold by {seller}, {availability}.",
      "{name}, a product sold by {seller}.",
      "{name}, a product for {price}, {availability}.",
      "{name}, a product for {price}.",
      "{name}, a product for {price_month} a month, {availability}.",
      "{name}, a product for {price_month} a month.",
      "{name}, a product for {price_year} a year, {availability}.",
      "{name}, a product for {price_year} a year.",
      "{name}, a product, {availability}.",
      "{name}, a product."
    ]]
  },
  "Service": {
    "label": "Service",
    "primary_type": "Service",
    "kind": { "label": "Plans for a service", "name": "plans for a service", "earn": "No search feature of its own. For memberships, subscriptions and services, with their prices.", "icon": "layers", "order": 2 },
    "main": ["offers_price", "offers_priceCurrency", "billing"],
    "refs": { "provider": "identity" },
    "nested": { "offers": "Offer" },
    "props": [
      { "key": "name", "label": "Name", "kind": "text", "compose": true, "default": { "fact": "title" }, "level": "required" },
      { "key": "description", "label": "Summary", "kind": "text", "compose": true, "default": { "fact": "description" } },
      { "key": "offers_price", "label": "Price", "kind": "number", "ai": false },
      { "key": "offers_priceCurrency", "label": "Currency", "kind": "currency", "ai": false },
      { "key": "billing", "label": "Billed", "kind": "enum", "options": ["once", "P1M", "P1Y"], "option_labels": { "once": "once", "P1M": "every month", "P1Y": "every year" }, "emit": false, "ai": false }
    ],
    "slots": {
      "name": { "path": "name", "prop": "name" },
      "provider": { "path": "provider.name", "site": "identity.name", "label": "Provider" },
      "price": { "path": "offers.price", "prop": "offers_price", "currency": "offers.priceCurrency", "unless": "offers.priceSpecification.billingDuration" },
      "price_month": { "path": "offers.price", "prop": "offers_price", "currency": "offers.priceCurrency", "if": { "offers.priceSpecification.billingDuration": "P1M" } },
      "price_year": { "path": "offers.price", "prop": "offers_price", "currency": "offers.priceCurrency", "if": { "offers.priceSpecification.billingDuration": "P1Y" } }
    },
    "say": [[
      "{name}, a service from {provider} for {price}.",
      "{name}, a service from {provider} for {price_month} a month.",
      "{name}, a service from {provider} for {price_year} a year.",
      "{name}, a service from {provider}."
    ]]
  },
  "ProfilePage": {
    "label": "Profile",
    "page_type": "ProfilePage", "primary_type": "Person", "og_type": "profile",
    "kind": { "label": "A person's profile", "name": "a profile", "earn": "Can show the person's name and photo with results from the page.", "icon": "person", "order": 5 },
    "main": ["image", "jobTitle"],
    "props": [
      { "key": "name", "label": "Name", "kind": "text", "compose": true, "default": { "fact": "title" }, "level": "required" },
      { "key": "description", "label": "About", "kind": "text", "compose": true, "default": { "fact": "description" } },
      { "key": "image", "label": "Photo", "kind": "image", "default": { "fact": "image" } },
      { "key": "jobTitle", "label": "Role", "kind": "text" },
      { "group": "worksFor", "use": "who", "label": "Works for", "type": "Organization", "ref": { "label": "Works for", "accept": ["Organization"], "site": true } },
      { "key": "sameAs", "label": "Profiles elsewhere", "kind": "url", "list": true, "max": 10 }
    ],
    "slots": {
      "name": { "path": "name", "prop": "name" },
      "role": { "path": "jobTitle", "prop": "jobTitle" }
    },
    "say": [[
      "{name}, {role}, on a profile page.",
      "{name}, on a profile page."
    ]]
  },
  "JobPosting": {
    "label": "Job posting",
    "primary_type": "JobPosting",
    "kind": { "label": "A job posting", "name": "a job posting", "earn": "Can show in job listings with the pay and where the work is.", "not_for": "Set up on a content type: one page per job.", "icon": "backpack", "order": 6 },
    "scopes": { "page": "component" },
    "main": ["description", "hiringOrganization", "work", "jobLocation"],
    "props": [
      { "key": "title", "label": "Job title", "kind": "text", "compose": true, "default": { "fact": "title" }, "level": "required" },
      { "key": "description", "label": "Description", "kind": "text", "html": true, "link_only": true, "level": "required", "ai": false },
      { "key": "datePosted", "label": "Posted", "kind": "date", "default": { "fact": "published" }, "level": "required" },
      { "key": "validThrough", "label": "Closing date", "kind": "date", "per_item": true },
      { "key": "employmentType", "label": "Employment type", "kind": "enum", "list": true, "options": ["FULL_TIME", "PART_TIME", "CONTRACTOR", "TEMPORARY", "INTERN", "VOLUNTEER"], "option_labels": { "FULL_TIME": "full time", "PART_TIME": "part time", "CONTRACTOR": "contract", "TEMPORARY": "temporary", "INTERN": "internship", "VOLUNTEER": "volunteer" }, "emit": "code", "ai": false },
      { "group": "hiringOrganization", "use": "who", "label": "Employer", "type": "Organization", "level": "required", "ref": { "label": "Employer", "accept": ["Organization"], "site": true } },
      { "key": "work", "label": "Where the work is", "kind": "enum", "options": ["onsite", "remote", "both"], "option_labels": { "onsite": "on site", "remote": "fully remote", "both": "on site or remote" }, "emit": false, "ai": false },
      { "key": "applicantLocationRequirements", "label": "Open to people in", "kind": "enum", "list": true, "max": 50, "codes": "country", "item": "Country", "emit": "code", "under": "work", "when": { "work": ["remote", "both"] }, "ai": false },
      { "group": "jobLocation", "use": "venue", "label": "Workplace", "list": true, "when": { "work": ["onsite", "both"] }, "ref": { "label": "Workplace page", "accept": ["Place"], "inline": "address", "per_item": true } },
      { "group": "baseSalary", "use": "pay", "label": "Pay" }
    ],
    "slots": {
      "title": { "path": "title", "prop": "title" },
      "employer": { "path": "hiringOrganization.name", "prop": "hiringOrganization_name" },
      "city": { "path": "jobLocation.address.addressLocality", "prop": "jobLocation_address_addressLocality" }
    },
    "say": [[
      "{title}, a job at {employer} in {city}.",
      "{title}, a job at {employer}.",
      "{title}, a job in {city}.",
      "{title}, a job posting."
    ]]
  },
  "LocalBusiness": {
    "label": "A place people visit",
    "primary_type": "LocalBusiness",
    "kind": { "label": "A place people visit", "name": "a place people visit", "earn": "Can show its address, opening hours and phone number in local results.", "not_for": "Not for a business with no address customers visit.", "icon": "home", "order": 7 },
    "main": ["address", "openingHoursSpecification", "telephone"],
    "props": [
      { "key": "name", "label": "Name", "kind": "text", "compose": true, "default": { "fact": "title" }, "level": "required" },
      { "key": "placeKind", "label": "Kind of place", "kind": "enum", "default": { "text": "LocalBusiness" }, "emit": "type", "options": ["Store", "Restaurant", "CafeOrCoffeeShop", "BarOrPub", "Bakery", "Hotel", "Dentist", "MedicalClinic", "HealthAndBeautyBusiness", "LegalService", "FinancialService", "RealEstateAgent", "HomeAndConstructionBusiness", "AutomotiveBusiness", "SportsActivityLocation", "Library", "ChildCare", "TravelAgency", "LocalBusiness", "EventVenue"], "option_labels": { "Store": "store", "Restaurant": "restaurant", "CafeOrCoffeeShop": "café or coffee shop", "BarOrPub": "bar or pub", "Bakery": "bakery", "Hotel": "hotel", "Dentist": "dentist", "MedicalClinic": "medical clinic", "HealthAndBeautyBusiness": "health and beauty", "LegalService": "legal service", "FinancialService": "financial service", "RealEstateAgent": "real estate agent", "HomeAndConstructionBusiness": "home and construction", "AutomotiveBusiness": "automotive", "SportsActivityLocation": "sports and fitness", "Library": "library", "ChildCare": "child care", "TravelAgency": "travel agency", "LocalBusiness": "other local business", "EventVenue": "a venue (not a business)" }, "ai": false },
      { "key": "description", "label": "Summary", "kind": "text", "compose": true, "default": { "fact": "description" } },
      { "key": "image", "label": "Image", "kind": "image", "default": { "fact": "image" } },
      { "key": "url", "label": "Web address", "kind": "url", "default": { "fact": "url" } },
      { "group": "address", "use": "address", "label": "Address", "level": "required" },
      { "key": "openingHoursSpecification", "label": "Opening hours", "kind": "hours", "ai": false },
      { "key": "telephone", "label": "Telephone", "kind": "text", "pattern": "^\\+?[0-9][0-9 ()./-]{4,30}$", "ai": false },
      { "group": "geo", "use": "geo", "label": "Coordinates" },
      { "key": "priceRange", "label": "Price range", "kind": "text", "ai": false },
      { "key": "menu", "label": "Menu", "kind": "url", "when": { "placeKind": ["Restaurant", "CafeOrCoffeeShop", "BarOrPub", "Bakery"] } },
      { "key": "servesCuisine", "label": "Cuisine", "kind": "text", "join": ", ", "when": { "placeKind": ["Restaurant", "CafeOrCoffeeShop", "BarOrPub", "Bakery"] } }
    ],
    "slots": {
      "name": { "path": "name", "prop": "name" },
      "city": { "path": "address.addressLocality", "prop": "address_addressLocality" }
    },
    "say": [[
      "{name}, a place in {city}.",
      "{name}, a place people visit."
    ]]
  },
  "Recipe": {
    "label": "Recipe",
    "primary_type": "Recipe",
    "kind": { "label": "A recipe", "name": "a recipe", "earn": "Can show in recipe results with its photo and times.", "icon": "recipe", "order": 8 },
    "main": ["recipeIngredient", "recipeInstructions", "prepTime", "cookTime", "totalTime", "image"],
    "props": [
      { "key": "name", "label": "Name", "kind": "text", "compose": true, "default": { "fact": "title" }, "level": "required" },
      { "key": "image", "label": "Image", "kind": "image", "list": true, "max": 10, "default": { "fact": "image" } },
