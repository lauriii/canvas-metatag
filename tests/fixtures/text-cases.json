{
  "facts": {
    "title": "Pricing",
    "description": "Plans and prices.",
    "site": "Example"
  },
  "separator": "|",
  "site": {},
  "cases": [
    {
      "name": "nothing set",
      "expect": {
        "title": "Pricing | Example",
        "description": "Plans and prices.",
        "social_title": "Pricing",
        "social_description": "Plans and prices."
      }
    },
    {
      "name": "the main part is the target's own",
      "target": {
        "title": {
          "text": "Plans for every team"
        }
      },
      "expect": {
        "title": "Plans for every team | Example",
        "social_title": "Pricing"
      }
    },
    {
      "name": "braces in typed text are literal",
      "target": {
        "title": {
          "text": "{Title} {a b} {} { title } {site}"
        }
      },
      "expect": {
        "title": "{Title} {a b} {} { title } {site} | Example"
      }
    },
    {
      "name": "a linked value is never filled",
      "target": {
        "title": {
          "source": {
            "sourceType": "entity-field",
            "expression": "ℹ︎␜entity:node:article␝field_byline␞␟value"
          }
        }
      },
      "links": {
        "ℹ︎␜entity:node:article␝field_byline␞␟value": "{site}"
      },
      "expect": {
        "title": "{site} | Example"
      }
    },
    {
      "name": "an empty main part leaves no separator",
      "facts": {
        "title": ""
      },
      "expect": {
        "title": "Example",
        "social_title": "",
        "title_main": "",
        "title_end": "Example"
      }
    },
    {
      "name": "an empty ending leaves no separator",
      "facts": {
        "site": ""
      },
      "expect": {
        "title": "Pricing",
        "title_main": "Pricing",
        "title_end": ""
      }
    },
    {
      "name": "no ending",
      "target": {
        "title_end": {
          "text": ""
        }
      },
      "expect": {
        "title": "Pricing",
        "title_end": ""
      }
    },
    {
      "name": "the site sets the ending",
      "site": {
        "title_end": {
          "text": "Example Co"
        }
      },
      "expect": {
        "title": "Pricing | Example Co"
      }
    },
    {
      "name": "the site sets no ending",
      "site": {
        "title_end": {
          "text": ""
        }
      },
      "expect": {
        "title": "Pricing"
      }
    },
    {
      "name": "the target's ending wins",
      "site": {
        "title_end": {
          "text": "Example Co"
        }
      },
      "target": {
        "title_end": {
          "text": "Journal"
        }
      },
      "expect": {
        "title": "Pricing | Journal",
        "title_end": "Journal"
      }
    },
    {
      "name": "a linked ending",
      "target": {
        "title_end": {
          "source": {
            "sourceType": "entity-field",
            "expression": "ℹ︎␜entity:node:article␝field_section␞␟value"
          }
        }
      },
      "links": {
        "ℹ︎␜entity:node:article␝field_section␞␟value": "Guides"
      },
      "expect": {
        "title": "Pricing | Guides"
      }
    },
    {
      "name": "an empty linked ending gives the site name",
