{
  "tokens": { "title": "Pricing", "description": "Plans and prices.", "site": "Example", "sep": "|" },
  "site": { "title": "{title} {sep} {site}" },
  "cases": [
    { "name": "nothing set",
      "expect": { "title": "Pricing | Example", "description": "Plans and prices.", "social_title": "Pricing", "social_description": "Plans and prices." } },
    { "name": "target title overrides the site pattern",
      "target": { "title": "Plans for every team {sep} {site}" },
      "expect": { "title": "Plans for every team | Example", "social_title": "Pricing" } },
    { "name": "unknown token is blanked",
      "target": { "title": "{title} {field.gone} {sep} {site}" },
      "expect": { "title": "Pricing | Example" } },
    { "name": "brace text outside the grammar is literal",
      "target": { "title": "{Title} {a b} {} { title } {sep} {site}" },
      "expect": { "title": "{Title} {a b} {} { title } | Example" } },
    { "name": "a token value is not expanded again",
      "tokens": { "title": "{site}" },
      "expect": { "title": "{site} | Example" } },
    { "name": "empty first part leaves no leading separator",
      "tokens": { "title": "" },
      "expect": { "title": "Example", "social_title": "" } },
    { "name": "empty last part leaves no trailing separator",
      "tokens": { "site": "" },
      "expect": { "title": "Pricing" } },
    { "name": "adjacent separators collapse",
      "target": { "title": "{title} {sep} {field.section} {sep} {site}" },
      "tokens": { "field.section": "" },
      "expect": { "title": "Pricing | Example" } },
    { "name": "separator inside a word is text",
      "target": { "title": "Pay-as-you-go {sep} {site}" },
      "tokens": { "sep": "-" },
      "expect": { "title": "Pay-as-you-go - Example" } },
    { "name": "empty result falls back to the page title",
      "target": { "title": "{field.gone}" },
      "expect": { "title": "Pricing" } },
    { "name": "empty page title falls back to the site name",
      "target": { "title": "{title}" },
      "tokens": { "title": "" },
      "expect": { "title": "Example" } },
    { "name": "less-than and ampersand are text",
      "target": { "title": "I <3 Canvas & more" },
      "expect": { "title": "I <3 Canvas & more" } },
    { "name": "whitespace collapses and control characters go",
      "target": { "title": "  Pricing \n plans\u0007  " },
      "expect": { "title": "Pricing plans" } },
    { "name": "bidi override is removed",
      "target": { "title": "Pricing‮ {sep} {site}" },
      "expect": { "title": "Pricing | Example" } },
    { "name": "joined emoji survive",
      "target": { "title": "Team 👨‍👩 {sep} {site}" },
      "expect": { "title": "Team 👨‍👩 | Example" } },
    { "name": "template description bound to a field",
      "target": { "description": "{field.field_summary}" },
      "tokens": { "field.field_summary": "A short summary." },
      "expect": { "description": "A short summary.", "social_description": "A short summary." } },
    { "name": "empty bound field falls back to the content's own description",
      "target": { "description": "{field.field_summary}" },
      "tokens": { "field.field_summary": "" },
      "expect": { "description": "Plans and prices." } },
    { "name": "the site layer cannot supply a description",
      "site": { "title": "{title} {sep} {site}", "description": "Ignored" },
      "expect": { "description": "Plans and prices." } },
    { "name": "social overrides",
      "target": { "social": { "title": "{title}: compare plans", "description": "See every plan." } },
      "expect": { "social_title": "Pricing: compare plans", "social_description": "See every plan." } },
    { "name": "no description anywhere",
      "tokens": { "description": "" },
      "expect": { "description": "", "social_description": "" } },
    { "name": "a DEL character is removed",
      "target": { "title": "Pri\u007fcing {sep} {site}" },
      "expect": { "title": "Pricing | Example" } },
    { "name": "two empty parts leave no separator at the start",
      "target": { "title": "{title} {sep} {field.section} {sep} {site}" },
      "tokens": { "title": "", "field.section": "" },
      "expect": { "title": "Example" } },
    { "name": "two empty parts leave no separator at the end",
      "target": { "title": "{title} {sep} {field.section} {sep} {site}" },
      "tokens": { "site": "", "field.section": "" },
      "expect": { "title": "Pricing" } },
    {"name": "an emoji sequence at the limit is left out whole", "target": {"title": "01234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123👨‍👩‍👧"}, "expect": {"title": "01234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123"}},
    {"name": "a flag at the limit is left out whole", "target": {"description": "🇫🇮0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678", "social": {"title": "01234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123🇫🇮0123456789012345678901234567890123456789", "description": "🇫🇮0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678"}}, "expect": {"description": "", "social_title": "01234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123", "social_description": ""}},
    {"name": "a letter with its marks at the limit is left out whole", "target": {"title": "01234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123é"}, "expect": {"title": "01234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123"}},
    {"name": "a cut inside a word ends at the last space", "target": {"social": {"title": "Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts "}}, "expect": {"social_title": "Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts Concerts"}},
    {"name": "a cut that leaves a separator ends before it", "target": {"title": "{title} {sep} Events"}, "tokens": {"title": "An unusually long evening programme of chamber music, songs and readings in which every work is introduced by the musicians themselves, followed by a conversation with the audience about how new music is commissioned, rehearsed and first performed"}, "expect": {"title": "An unusually long evening programme of chamber music, songs and readings in which every work is introduced by the musicians themselves, followed by a conversation with the audience about how new music is commissioned, rehearsed and first performed"}},
    {"name": "a text without spaces is cut at the limit", "target": {"title": ""}, "expect": {"title": "012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234"}},
    {"name": "a space far from the limit is not used", "target": {"title": "Pricing "}, "expect": {"title": "Pricing 0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456"}}
  ]
}
